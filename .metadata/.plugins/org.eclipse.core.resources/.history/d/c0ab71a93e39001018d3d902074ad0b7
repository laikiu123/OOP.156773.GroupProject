package SVBK.model;

import java.util.List;

/**
 * Sinh viên hệ niên chế (Part-time), tham chiếu Program để kiểm tra.
 */
public class PartTimeStudent extends Student {
    /** Program gồm danh sách học phần cố định. */
    private Program program;
    /** Điểm trung bình tối thiểu để tốt nghiệp. */
    private static final double MIN_AVERAGE = 5.0;

    /**
     * Constructor đầy đủ sinh viên và Program.
     */
    public PartTimeStudent(String studentID,
                            String studentName,
                            Program program) {
        super(studentID, studentName, "Part-time");
        this.program = program;
    }

    // ===== Getter / Setter =====
    public Program getProgram() { return program; }
    public void setProgram(Program program) { this.program = program; }

    @Override
    public double calculateFinalGrade() {
        List<Course> list = program.getRequiredCourses();
        if (list.isEmpty()) return 0.0;
        double sum = 0;
        for (Course c : list) {
            sum += c.calculateFinalGrade();
        }
        return sum / list.size();
    }

    /**
     * Kiểm tra tốt nghiệp:
     */
    @Override
    public boolean checkGraduation() {
        for (Course c : program.getRequiredCourses()) {
            if (!getCompletedCourseIDs().contains(c.getCourseID())) return false;
        }
        return calculateFinalGrade() >= MIN_AVERAGE;
    }
}