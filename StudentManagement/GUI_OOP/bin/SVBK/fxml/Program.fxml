<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171">
    <top>
        <Label text="Quản lý chương trình đào tạo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 20px;" />
    </top>
    <center>
        <VBox spacing="10" alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <Button text="1. Thêm chương trình" prefWidth="300" />
                <Button text="2. Xóa chương trình" prefWidth="300" />
                <Button text="3. Tìm chương trình" prefWidth="300" />
                <Button text="4. Đổi tên chương trình" prefWidth="300" />
                <Button text="5. Thêm học phần vào chương trình" prefWidth="300" />
                <Button text="6. Xóa học phần khỏi chương trình" prefWidth="300" />
                <Button text="7. Chỉnh ngưỡng tín chỉ tự chọn" prefWidth="300" />
                <Button text="8. Chỉnh ngưỡng tín chỉ bắt buộc" prefWidth="300" />
                <Button text="9. Danh sách chương trình" prefWidth="300" />
                <Button text="0. Quay lại" prefWidth="300" style="-fx-background-color: #cccccc;" />
            </children>
        </VBox>
    </center>
</BorderPane>
