<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      fillWidth="true"                
      spacing="22"
      style="-fx-background-color: #f0f2f5;"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.MainMenuController">

    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>

    <children>

        <Label text="SSMS by SVBK" textFill="#1c2b4d">
            <font>
                <Font name="System Bold" size="30"/>
            </font>
            <VBox.margin>
                <Insets bottom="8"/>
            </VBox.margin>
        </Label>

        <Label text="Student Management System" style="-fx-text-fill: #6b7a99; -fx-font-size: 13;"/>

        <!-- Đặt maxWidth cho container  để nút không kéo quá rộng trên màn lớn -->
        <VBox spacing="14" fillWidth="true" maxWidth="900">
            <children>

                <Button fx:id="btnStudentManagement"
                        text="1. Quản lý sinh viên"
                        onAction="#handleStudentManagement"
                        prefHeight="56"             
                        maxWidth="Infinity"
                        style="-fx-font-size: 18; -fx-background-color: #1877F2; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);"/>

                <Button fx:id="btnProgramManagement"
                        text="2. Quản lý chương trình"
                        onAction="#handleProgramManagement"
                        prefHeight="56"
                        maxWidth="Infinity"
                        style="-fx-font-size: 18; -fx-background-color: #1877F2; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);"/>

                <Button fx:id="btnCourseManagement"
                        text="3. Quản lý học phần"
                        onAction="#handleCourseManagement"
                        prefHeight="56"
                        maxWidth="Infinity"
                        style="-fx-font-size: 18; -fx-background-color: #1877F2; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);"/>

                <Button fx:id="btnGrading"
                        text="4. Nhập điểm"
                        onAction="#handleGrading"
                        prefHeight="56"
                        maxWidth="Infinity"
                        style="-fx-font-size: 18; -fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);"/>

                <Button fx:id="btnGraduationCheck"
                        text="5. Kiểm tra tốt nghiệp"
                        onAction="#handleGraduationCheck"
                        prefHeight="56"
                        maxWidth="Infinity"
                        style="-fx-font-size: 18; -fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);"/>

            </children>
        </VBox>

        <!-- Nút thoát -->
        <Button fx:id="btnExit"
                text="0. Thoát"
                onAction="#handleExit"
                prefHeight="56"
                maxWidth="900"
                style="-fx-font-size: 18; -fx-background-color: #d83b01; -fx-text-fill: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.25, 0, 2);">
            <VBox.margin>
                <Insets top="18"/>
            </VBox.margin>
        </Button>

    </children>
</VBox>
