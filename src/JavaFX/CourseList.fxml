<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.CourseListController"
      spacing="10" alignment="CENTER" >

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Danh sách học phần" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <ListView fx:id="listCourses" prefWidth="400" prefHeight="300" />

    <Button text="Đóng" fx:id="btnClose" maxWidth="100" onAction="#handleClose" />

</VBox>
