<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?> <?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.MainMenuController"
      spacing="18" alignment="CENTER" prefWidth="450.0" style="-fx-background-color: #f0f2f5;"> 

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Hệ Thống Quản Lý" textFill="#1c2b4d">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
        <VBox.margin>
            <Insets bottom="30.0" />
        </VBox.margin>
    </Label>

    <Button text="1. Quản lý sinh viên" fx:id="btnStudentManagement" maxWidth="Infinity" onAction="#handleStudentManagement" 
            style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
    
    <Button text="2. Quản lý chương trình" fx:id="btnProgramManagement" maxWidth="Infinity" onAction="#handleProgramManagement"
            style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
            
    <Button text="3. Quản lý học phần" fx:id="btnCourseManagement" maxWidth="Infinity" onAction="#handleCourseManagement"
            style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
            
    <Button text="4. Nhập điểm" fx:id="btnGrading" maxWidth="Infinity" onAction="#handleGrading"
            style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #107C10; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
            
    <Button text="5. Kiểm tra tốt nghiệp" fx:id="btnGraduationCheck" maxWidth="Infinity" onAction="#handleGraduationCheck"
            style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #107C10; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
    
    <VBox VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER"> <padding>
            <Insets top="20.0" /> 
        </padding>
        <Button text="0. Thoát" fx:id="btnExit" maxWidth="Infinity" onAction="#handleExit"
                style="-fx-font-size: 14px; -fx-pref-height: 45px; -fx-background-color: #D83B01; -fx-text-fill: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.2, 0, 2);"/>
    </VBox>
</VBox>