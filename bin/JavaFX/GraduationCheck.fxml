<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.GraduationCheckController">
    <center>
        <VBox alignment="TOP_CENTER" spacing="10" prefWidth="500" prefHeight="400">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label alignment="CENTER" text="KIỂM TRA ĐIỀU KIỆN TỐT NGHIỆP">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="15" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Mã sinh viên:" minWidth="80"/>
                <TextField fx:id="studentIdField" prefWidth="250" promptText="Nhập mã sinh viên" HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleCheckGraduation" text="Kiểm tra" prefWidth="80"/>
                <HBox.margin>
                    <Insets bottom="10" />
                </HBox.margin>
            </HBox>

            <TextArea fx:id="resultArea" editable="false" prefHeight="250" promptText="Kết quả kiểm tra sẽ hiển thị ở đây..." wrapText="true" VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
                <Button fx:id="backButton" onAction="#handleBackToMainMenu" text="Quay Lại" prefWidth="100"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>