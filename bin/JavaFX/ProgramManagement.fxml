<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ProgramManagementController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="Quản lý Chương trình Đào tạo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" />
            <TableView fx:id="tablePrograms" prefHeight="350.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMajorName" minWidth="250.0" prefWidth="300.0" text="Tên Ngành/Chương trình" />
                    <TableColumn fx:id="colTotalCredits" minWidth="100.0" prefWidth="180.0" text="Tổng Tín chỉ tốt nghiệp" />
                    <TableColumn fx:id="colElectiveCredits" minWidth="100.0" prefWidth="180.0" text="Tín chỉ tự chọn yêu cầu" />
                </columns>
                <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="10.0" />
                </padding>
                <Button fx:id="btnAddProgram" text="Thêm Mới Chương trình..." onAction="#handleAddNewProgramDetailed" />
                <Button fx:id="btnEditProgram" text="Xem Chi tiết / Sửa..." onAction="#handleEditProgramDetailed" />
                <Button fx:id="btnDeleteProgram" text="Xóa Chương trình" onAction="#handleDeleteProgram" />
                <Button fx:id="btnRefreshPrograms" text="Làm Mới DS" onAction="#handleRefreshPrograms" />
            </HBox>
             <HBox alignment="BOTTOM_RIGHT" spacing="10.0" VBox.vgrow="NEVER">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Button fx:id="btnBackToMainMenuProgram" text="Quay lại Menu Chính" onAction="#handleBackToMainMenuProgram" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>