<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ProgramManagementController"
            prefWidth="1100" prefHeight="650">

    <!-- (Tuỳ chọn) gắn CSS ngoài -->
    <!-- <stylesheets><URL value='@style.css'/></stylesheets> -->

    <!-- Header -->
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" left="24" right="24" bottom="12"/></padding>
            <Label text="Quản lý Chương trình Đào tạo">
                <font><Font size="22"/></font>
            </Label>

            <!-- Thanh công cụ: ô tìm kiếm + nút thêm nhanh -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="Tìm theo tên ngành/chương trình..."
                           HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAddProgram" text="Thêm Mới Chương trình..."
                        onAction="#handleAddNewProgramDetailed"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Card chứa bảng -->
    <center>
        <VBox alignment="TOP_CENTER">
            <padding><Insets left="24" right="24" bottom="20"/></padding>
            <VBox maxWidth="10000" spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 6);">

                <TableView fx:id="tablePrograms" prefHeight="460" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Chưa có dữ liệu. Hãy thêm chương trình mới hoặc làm mới danh sách."/>
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="colMajorName"
                                     text="Tên Ngành/Chương trình"
                                     minWidth="320" prefWidth="520"/>

                        <TableColumn fx:id="colTotalCredits"
                                     text="Tổng Tín chỉ tốt nghiệp"
                                     minWidth="160" prefWidth="240"
                                     style="-fx-alignment: CENTER-RIGHT;"/>

                        <TableColumn fx:id="colElectiveCredits"
                                     text="Tín chỉ tự chọn yêu cầu"
                                     minWidth="160" prefWidth="240"
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                    </columns>

                    <!-- Chia đều độ rộng, giữ biên tối thiểu -->
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Hàng nút tác vụ dưới bảng -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnEditProgram" text="Xem Chi tiết / Sửa..."
                            onAction="#handleEditProgramDetailed"/>
                    <Button fx:id="btnDeleteProgram" text="Xóa Chương trình"
                            onAction="#handleDeleteProgram"/>
                    <Button fx:id="btnRefreshPrograms" text="Làm Mới DS"
                            onAction="#handleRefreshPrograms"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnBackToMenu" text="Quay lại Menu Chính"
                            onAction="#handleBackToMainMenuProgram"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
